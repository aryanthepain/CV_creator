# Server Configuration
PORT=5000
NODE_ENV=development

# Authentication — Google OAuth 2.0
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_CALLBACK_URL=/auth/google/callback

# Frontend URL (for CORS and OAuth redirects)
CLIENT_URL=http://localhost:3000

# Session Secret — REQUIRED, must be a strong random string
# Generate one: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
SECRETKEY=your_session_secret_here

# MongoDB Connection URI
MONGODB_URI=mongodb://localhost:27017/hexcode

# AI API Keys
CLAUDE_API_KEY=your_anthropic_claude_api_key_here
